  QueueDeliveriesRead.{ Address Vector<VisibleQueueDelivery> }
  SendOutcomesRead.Vector<VisibleSendOutcomeRecord>
  LegacyArchiveObserved.Vector<VisibleLegacyArchiveEntry>
  Debugged.DebugSnapshot
  QueueDeliveryResolved.{ Address VisibleQueueDeliveryResolution }
  Inspected.{ VisibleMetaflow Binding Vector<Lock> Vector<VisibleAttempt> Option<RestartRecord> }
  DeliveryDebugged.{ DeliverySnapshot Receipt.Option<NativeReceipt> ReadBy.Option<LogicalDeliveryId> }
  Rebound.Address
  Withdrawn
  Unconfigured                                  ; ObserveConfiguration's; its frames are Configuration
  Removed.Removal                               ; the Removal given, echoed whole
  ConfigureRefused.ConfigureRefusal
  ResetRejected.ResetRejection
  FlowRegistrationRejected.FlowRegistrationRejection
  BindExistingRejected.BindExistingRejection
  RetireRejected.RetireRejection
  RestartRefused.RestartRefusal
  RefreshRejected.RefreshRejection
  OrdinaryRefused.Refusal
  DeliveryRejected.DeliveryRejection
  CommandRejected.CommandRejection
  PeerResolutionRejected.CallerResolutionRejection
  Refused.StoreRefusal
  ReadEventsRejected.[ UnknownFlow StoreRefused ]
  ReadQueueDeliveriesRejected.[ UnknownAddress StoreRefused ]
  ReadSendOutcomesRejected.[ StoreRefused ]
  ObserveLegacyArchiveRejected.StoreRefusal
  ResolveQueueDeliveryRejected.VisibleResolveQueueDeliveryRejected
  InspectRejected.[ UnknownAddress ]
  RebindRejected.[ UnknownAddress PaneAbsent FlowUnknown NotAwake HerdrUnavailable FlowTaken.Address ]
  DebugDeliveryRejected.[ UnknownRequest StoreRefused ]
  WithdrawRejected.[ UnknownAddress NotQueued ]
  RefreshQueued
  RestartQueued.FlowId
  ReapPending ]
[ ; The meta contract owns this read projection; Memory owns its stored form.
  StopMetadata.{                     ; a Stop's correlation and background-work metadata
     Option<NativeSessionId>
     Option<TranscriptPath>
     BackgroundWork }
  HarnessEventMetadata.[             ; event identity and metadata, in ordinary Event's order
     Started.Option<NativeSessionId>
     ToolUsed.String
     Stopped.StopMetadata
     PromptSubmitted.NativePrompt
     Ended.Option<NativeSessionId>
     Cleared.Option<NativeSessionId> ]
  ; Flow Library owns the shared configuration field types.
  ; This record exists only for Flow's current internal launch defaults.
  ; The process sockets are separately supplied by Library.Place; this
  ; record is not a Configure wire payload.
  ; A Nexus that does not own a Message Nexus executable carries None.
  NexusRuntimeSettings.{ OrdinarySocketPath MetaSocketPath SourceRoot CodexEndpoint CodexEndpoint Vector<HarnessProfile> MetaAspects Option<MessageNexusPath> Option<MessageNexusBinary> Lease }
  ; The native model a seat of one Model runs, in every aspect; a Start
  ; naming another native model for that seat is refused.
  ConfigureModel.{ Model Native.String }
  ; The refresh threshold of the flows that run one model, in tokens.
  ConfigureThreshold.{ ModelName RefreshThreshold.Integer }
  ; The model policy governing handover warning and reminder behavior.
  HandoverPolicy.{ ModelName WarningShareLeft.Integer ReminderText.String EveryMinutes.Integer }
  Repository.String
  Path.String
  HandoverPoliciesConfiguration.[ Configured.Vector<HandoverPolicy> Unconfigured ]
  HandoverArchiveConfiguration.[ Configured.Path Unconfigured ]
  HandoverCountConfiguration.[ Configured.Integer Unconfigured ]
  HarnessHookConfiguration.[ Configured.Path Unconfigured ]
  ; Whole handover archive publication budget, in milliseconds.
  Duration.Integer
  CurriculumNexusPath.String
  ; Optional presentation guidance preserved exactly as configured, including
  ; its whitespace and line breaks.
  PresentationPrompt.String
  ; A Nexus that does not own a Message Nexus executable carries None.
  ; HerdrSessionName is the one Herdr session every launch opens its pane in.
  ConfigureNexus.{ SourceRoot CodexEndpoint CodexEndpoint HarnessProfiles MetaAspects Option<MessageNexusPath> Option<MessageNexusBinary> CurriculumNexusPath Lease Option<PresentationPrompt> HerdrSessionName }
  CodexAppServerBinary.String
  McpSendServerBinary.String
  ConfigureSendServer.{ CodexAppServerBinary McpSendServerBinary }
  ; How a metaflow continues. OnDemand: a flow whose turn ends with nothing
  ; queued has its harness and pane closed, the metaflow Asleep with its
  ; address and transcript kept, and a request that wakes starts the next
  ; flow with the whole queue. Maintained: the metaflow is never without a
  ; running flow; a flow refreshed, at its threshold or by order, or ended
  ; unexpectedly (its harness gone) is followed by a successor whether or
  ; not anything is queued, the successor confirmed before the predecessor
  ; is reaped, and an idle flow keeps its harness. A metaflow is Maintained
  ; by its exact Address, never by its Model.
  Continuity.[ OnDemand Maintained ]
  ; What the metaflow is for, composed with the brief into the first prompt.
  Purpose.String
  ; The workspace a metaflow's flows run in. None takes the Nexus source root.
  Root.String
  ; A record of the living the metaflow rests on, as a path under the
  ; records root.
  RecordPath.String
  Records.Vector<RecordPath>
  ; A permaflow's declaration, everything Flow holds about its Address: the
  ; workspace its flows run in, the leave-outs its flows start without
  ; when a Start names none (each of the harness its Model runs on), the
  ; context modules a Launch of its Address composes into the system prompt
  ; and into the first user message, its kind and tool set, how it
  ; continues, its purpose and the records it rests on.
  ConfigureMetaflow.{ Address Option<Root> LeaveOuts SystemModules PromptModules FlowKind ToolSet Continuity Purpose Records }
  ; One value of one permaflow, changed alone by Configure.Amend. Workspace,
  ; Purpose, Kind and Continuity replace that value; Add appends one
  ; element to the end of its list, Remove takes it out.
  Change.[ Workspace.Option<Root>
           Purpose
           Kind.FlowKind
           Continuity
           Add.Element
           Remove.Element ]
  ; One element of a permaflow's lists: a module of its system prompt, a
  ; module of its first prompt (its PromptModules), or a leave-out.
  Element.[ SystemModule.ModuleIdentity
            PromptModule.ModuleIdentity
            LeaveOut ]
  ; Extra native harness arguments for one metaflow. The empty string is no
  ; arguments. Flow parses this shell-word grammar before any launch effect.
  HarnessFlagText.String
  ConfigureHarnessFlags.{ Address HarnessFlagText }
  ; The next id each family allocates.
  ConfigureCounters.{ LogicalDelivery.Integer QueueAttempt.Integer SendOutcome.Integer }
  DrawBound.Integer
  TryBound.Integer
  HeartbeatPeriodSeconds.Integer
  HeartbeatRecipients.Vector<Address>
  HeartbeatConfig.{ HeartbeatPeriodSeconds HeartbeatRecipients }
  CountersRefusal.[ NotEmpty Lowered.ConfigureCounters NotRunning ]
  ; Keep the payload type distinct from the unit Input.Configuration variant.
  ConfigurationChange.[ Models.Vector<ConfigureModel>
                         Thresholds.Vector<ConfigureThreshold>
                         HandoverPolicies.Vector<HandoverPolicy>
                         HandoverArchive.Path
                         HandoverCount.Integer
                         PublicationDeadline.Duration
                         Nexus.ConfigureNexus
                         SendServers.Vector<ConfigureSendServer>
                         Metaflows.Vector<ConfigureMetaflow>
                         HarnessFlags.Vector<ConfigureHarnessFlags>
                         Investigation.Address
                         DefaultMinutes.Minutes
                         Heartbeat.Option<HeartbeatConfig>
                         ProtectedAddresses.Vector<Address>
                         Counters.ConfigureCounters
                         RequestIdDraws.DrawBound
                         AnnouncementTries.TryBound
                         HarnessHook.Path
                         Permaflow.ConfigureMetaflow
                         Harness.HarnessProfile
                         Refresh.ConfigureThreshold
                         Amend.{ Address Change } ]          ; one value of one permaflow
  ; One declaration taken away, by its key.
  Removal.[ Permaflow.Address
